---
layout: null
permalink: /taller-empresas/
---
{% import "icons-empresas.njk" as icons %}
{% set data = pages.empresas %}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ data.meta.seo.title }}</title>
  <meta name="description" content="{{ data.meta.seo.description }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ data.meta.seo.title }}">
  <meta property="og:description" content="{{ data.meta.seo.description }}">
  <meta property="og:image" content="{{ site.url }}{{ data.meta.seo.ogImage }}">
  <meta property="og:url" content="{{ site.url }}/taller-empresas/">
  <meta property="og:type" content="website">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ data.meta.seo.title }}">
  <meta name="twitter:description" content="{{ data.meta.seo.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ data.meta.seo.ogImage }}">

  {# Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@700&display=swap" rel="stylesheet">

  {# Font Awesome #}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous">

  {# Styles #}
  <link rel="stylesheet" href="/assets/css/empresas-landing.css">
  <link rel="stylesheet" href="/assets/css/main.css">

  <style>
    /* Tailwind-style utility classes */
